# Whitelist: only curated, original content goes public
/*
!/.gitignore
!/README.md
!/index.html
!/Companies/
!/Placement Training/

# Claude Code teaching skills are public; the rest of .claude/ stays private
!/.claude/
/.claude/*
!/.claude/skills/

# Resumes, JDs, third-party/personal docs stay private
Companies/**/*.pdf
Companies/**/*.docx
Companies/**/*.doc
# LaTeX resume sources contain phone/email in plaintext - never publish
Companies/**/*.tex
**/*resume_source.tex

# Copyrighted books and tool metadata
Placement Training/APTITUDE/
Placement Training/.claude/
Placement Training/.remember/
Placement Training/CLAUDE.md

# OS junk
Thumbs.db
desktop.ini
.DS_Store
~$*

# Extracted text of third-party assessment papers (same content as the PDFs)
Companies/**/sample_paper_text.txt
# Raw screenshots + verbatim transcripts of real proprietary OA content - study material, not for redistribution
Companies/**/PYQ*/
